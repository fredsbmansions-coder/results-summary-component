<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Results Summary Component</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="container">

        <div class="result">
            <h3>Your Result</h3>

            <div class="score">
                <h1>76</h1>
                <p>of 100</p>
            </div>

            <h2>Great</h2>

            <p class="result-text">
                You scored higher than 65% of the people who have taken these tests.
            </p>
        </div>

        <div class="summary">
            <h3>Summary</h3>

            <div class="summary-item reaction">
                <p>⚡ Reaction</p>
                <p><strong>80</strong> <span>/ 100</span></p>
            </div>

            <div class="summary-item memory">
                <p>🧠 Memory</p>
                <p><strong>92</strong> <span>/ 100</span></p>
            </div>

            <div class="summary-item verbal">
                <p>💬 Verbal</p>
                <p><strong>61</strong> <span>/ 100</span></p>
            </div>

            <div class="summary-item visual">
                <p>👁 Visual</p>
                <p><strong>72</strong> <span>/ 100</span></p>
            </div>

            <button>Continue</button>
        </div>

    </div>

</body>
</html>
